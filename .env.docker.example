# Public hostname that points to the Azure VM. Do not include https://.
API_DOMAIN=api.example.com

# Exact frontend origin. For a GitHub Pages project site, do not include the
# repository path because a CORS origin only contains scheme, host, and port.
WEB_ORIGIN=https://your-github-username.github.io

MYSQL_DATABASE=wedding
MYSQL_USER=wedding
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# URL-encode special characters in the password portion of DATABASE_URL.
DATABASE_URL=mysql://wedding:replace-with-a-url-encoded-password@mysql:3306/wedding

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
